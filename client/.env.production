# Production API base URL.
# The React app (Vercel) and the Express API (devprep-api.duckdns.org) are
# deployed separately, so production runs cross-origin and calls the API by its
# absolute URL. If REACT_APP_API_URL is also set in the Vercel dashboard, the
# dashboard value takes precedence over this file.
REACT_APP_API_URL=https://devprep-api.duckdns.org
